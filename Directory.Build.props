<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      NuGet audit: only flag vulnerabilities in packages WE reference directly.
      Transitive vulnerabilities are the responsibility of the upstream package
      maintainer (e.g. Npgsql) — when they ship a fix, we get it via restore.
      Without this, builds break whenever any dependency-of-a-dependency has
      an unpatched CVE, which is outside our control.
    -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
</Project>
