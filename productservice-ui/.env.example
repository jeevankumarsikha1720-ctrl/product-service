# Copy this file to .env.local to override the API URL during dev.
# Without this, the app talks to the deployed Azure backend.

# Local dev backend (HTTPS on 7080, HTTP on 5080):
# VITE_API_BASE_URL=http://localhost:5080/api

# Production Azure App Service (this is the default in code):
# VITE_API_BASE_URL=https://productservice-api-jk2026.azurewebsites.net/api
