{
  "ConnectionStrings": {
    "ProductsDb": "Server=localhost;Database=ProductService;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Auth": {
    "Issuer": "ProductService",
    "Audience": "ProductServiceUI",
    "TokenExpiryMinutes": 480,
    "AdminUsername": "admin",
    "// Secret + AdminPassword": "Set via env vars in production: Auth__Secret, Auth__AdminPassword. Dev values below are intentionally weak.",
    "Secret": "dev-only-secret-please-change-in-production-32chars",
    "AdminPassword": "admin"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
